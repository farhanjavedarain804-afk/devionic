RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Prevent directory listing
Options -Indexes

# Block access to sensitive files from being accessed via browser
<FilesMatch "^\.env|package\.json|package-lock\.json|schema\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>
